# ---- server ----
PORT=8777
DATA_DIR=./data

# ---- LiveKit (phone + web call sources) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- local STT (same endpoint ai-handler uses) ----
WHISPER_URL=http://localhost:6009/recognize
WHISPER_SAMPLE_RATE=16000
WHISPER_BOOST_VOLUME=true

# ---- Hecttor (same key/config ai-handler uses) ----
HECTTOR_API_KEY=
# defaults used when a candidate chain doesn't override them:
HECTTOR_MODEL=coda-vi-1.0
HECTTOR_ENHANCER_WEIGHT=1.0
HECTTOR_SAMPLE_RATE=16000
HECTTOR_CHUNK_MS=20

# ---- DTLN ----
DTLN_MODEL_DIR=./models/dtln

# ---- ai-coustics (self-service trial key from ai-coustics.com; the
#      LiveKit-Cloud-metered aic path is not exposed to Python) ----
AIC_LICENSE_KEY=
AIC_MODEL_ID=
AIC_MODEL_DIR=./models/aic

# Agent name the recorder registers under. Must match the LiveKit SIP dispatch
# rule for phone mode to work — otherwise the inbound call gets no agent and
# drops. Never run ai-handler against the same project while this shares its name.
LK_AGENT_NAME=inbound-agent

# ---- outbound phone call (the bench rings you) ----
# Outbound trunk to place the call on, and the number to ring (E.164).
LK_SIP_TRUNK_ID=ST_xxxxxxxxxxxx
LK_SIP_CALL_TO=+60xxxxxxxxx
LK_SIP_RINGING_TIMEOUT_S=45
