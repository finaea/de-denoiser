# ---- server ----
PORT=8777
DATA_DIR=./data

# ---- LiveKit (phone + web call sources) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- STT (any /recognize endpoint) ----
WHISPER_URL=http://localhost:6009/recognize
WHISPER_SAMPLE_RATE=16000
WHISPER_BOOST_VOLUME=true

# ---- VAD bench segmenter defaults (the livekit-agents state machine) ----
# Seed the VAD bench's parameter boxes for a run's first bench pass; after that
# the run keeps its own. A live deployment cuts the call into turns with a VAD
# and sends one turn per STT request, so a chain that shaves a word's onset
# loses it before the recogniser sees it — the bench's spans make that visible.
#
# These thresholds are TIGHTER than the livekit-agents defaults a production
# pipeline typically runs, min_speech 0.12 / min_silence 0.55. Shorter blips count as speech and
# a shorter pause ends a turn, so the timeline resolves into more, smaller spans
# and a shaved onset or a swallowed pause becomes visible. Put 0.12 / 0.55 back
# (here or in the bench panel) to compare against what production actually cuts.
VAD_ACTIVATION_THRESHOLD=0.50
VAD_DEACTIVATION_THRESHOLD=0.50
VAD_MIN_SPEECH_DURATION=0.05
VAD_MIN_SILENCE_DURATION=0.40
# Commonly left at the plugin default. It back-dates a span's start, so a
# highlight can legitimately begin just before audible speech, and it is the
# audio a VAD-cut STT request gets before each cut.
VAD_PREFIX_PADDING_DURATION=0.5

# ---- Hecttor (proprietary SDK; the wheel is installed separately, see README) ----
HECTTOR_API_KEY=
# defaults used when a candidate chain doesn't override them:
HECTTOR_MODEL=coda-vi-1.0
HECTTOR_ENHANCER_WEIGHT=1.0
HECTTOR_SAMPLE_RATE=16000
HECTTOR_CHUNK_MS=20

# ---- DTLN ----
DTLN_MODEL_DIR=./models/dtln

# ---- ai-coustics standalone SDK, the aicsdk-* candidates (self-service trial
#      key from ai-coustics.com). The LiveKit-hosted lkaic-* candidates need no
#      key: LiveKit Cloud authenticates and meters them. AIC_MODEL_ID is only the
#      fallback for an "aic" chain stage that names no model. ----
AIC_LICENSE_KEY=
AIC_MODEL_ID=
AIC_MODEL_DIR=./models/aic

# ---- cloud replay rail: streams per subscriber process, control included;
#      more candidates run in sequential batches ----
# CLOUD_REPLAY_MAX_STREAMS=9

# Agent name the recorder registers under. Must match the LiveKit SIP dispatch
# rule for phone mode to work — otherwise the inbound call gets no agent and
# drops. Never run another agent against the same project under this name.
LK_AGENT_NAME=inbound-agent

# ---- outbound phone call (the bench places the call) ----
# Outbound trunk to place the call on, and the number to ring (E.164).
LK_SIP_TRUNK_ID=ST_xxxxxxxxxxxx
LK_SIP_CALL_TO=+60xxxxxxxxx
LK_SIP_RINGING_TIMEOUT_S=45
